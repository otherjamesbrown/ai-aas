# OAuth Configuration
VITE_OAUTH_CLIENT_ID=your-client-id
VITE_OAUTH_ISSUER_URL=https://your-issuer.example.com
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/callback

# API Configuration
VITE_API_BASE_URL=http://localhost:8080/api

# Feature Flags
VITE_FEATURE_FLAGS_API_URL=http://localhost:8080/api/feature-flags

# OpenTelemetry Configuration
VITE_OTEL_SERVICE_NAME=portal
VITE_OTEL_SERVICE_VERSION=1.0.0
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Sentry Configuration
# Set this to your Sentry DSN in production deployments
# Leave empty for local development (Sentry will be disabled)
VITE_SENTRY_DSN=

# Logging Configuration
# Options: debug, info, warn, error
# Use "debug" for local development, "info" for production
VITE_LOG_LEVEL=debug
