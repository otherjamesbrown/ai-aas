{
  "allowedBashCommands": [
    "gh:*",
    "git:*",
    "npm:*",
    "pnpm:*",
    "make:*",
    "docker:*",
    "kubectl:*"
  ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/compliance-review.sh"
          }
        ]
      }
    ]
  }
}
