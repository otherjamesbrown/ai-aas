/tmp_md/
/tmp_md/*.tar.gz

# Environment files with secrets
# Note: .env files in secrets/env/ are encrypted with git-crypt
.env
.env.local
.env.e2e
.env.*.local

# Git-crypt key file (NEVER commit this!)
secrets/ai-aas-git-crypt.key
*.key.bak

# Unencrypted kubeconfigs (the encrypted ones are in secrets/kubeconfigs/)
kubeconfig*
*.kubeconfig
!secrets/kubeconfigs/
.DS_Store
services/ai-aas-cli/ai-aas-cli

# Built binaries
services/ai-aas-cli/bin/
services/api-router-service/api-router
services/user-org-service/user-org-service
services/admin-api-service/admin-api-service

# Temporary migration files
migrate.env
migrate.env.tmp

# Beads issue tracking (local only)
.beads/

# Claude Code extension
.cxp/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl
**/.generated/

# Local binaries
bin/
