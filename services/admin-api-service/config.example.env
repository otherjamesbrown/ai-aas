# Admin API Service Configuration
# Copy this file to .env and update values for your environment

# Server settings
PORT=8080
VERSION=v1.0.0

# Database settings (required)
DATABASE_URL=postgres://user:password@localhost:5432/aiaas?sslmode=disable

# Connection pool settings
DB_MAX_CONNS=50
DB_MIN_CONNS=10
DB_CONN_TIMEOUT=5s
DB_IDLE_TIMEOUT=5m

# Authentication
API_KEY_HASH_SALT=your-secret-salt-here

# Rate limiting
RATE_LIMIT_PER_MIN=100

# Logging
LOG_LEVEL=info  # debug, info, warn, error

# Observability
METRICS_ENABLED=true
TRACING_ENABLED=false
OTLP_ENDPOINT=  # e.g., http://otel-collector:4317

