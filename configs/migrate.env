# Operational database connection string
DB_URL=postgres://postgres:postgres@localhost:5432/ai_aas_operational?sslmode=disable

# Analytics warehouse connection string
ANALYTICS_URL=postgres://postgres:postgres@localhost:5432/ai_aas_operational?sslmode=disable

# Deterministic HMAC key used to hash sensitive identifiers
MIGRATION_EMAIL_HASH_KEY=test-local-dev-key-32bytes-long

# Component selector: operational | analytics
MIGRATION_COMPONENT=operational

# Require confirmation prompts (set to 0 to disable)
MIGRATION_REQUIRE_CONFIRMATION=0
